#!/bin/sh
#
# trxd: transceiver / beacon daemon.
# Config: /mnt/jffs2/trxd.toml if present (edit trxd.toml on the USB drive
# and eject: update.sh validates it and stores it there), else the firmware
# default /etc/trxd.toml.

DAEMON=/usr/bin/trxd
PIDFILE=/var/run/trxd.pid
LOG=/var/log/trxd.log

pick_config() {
	# /mnt/jffs2/trxd.toml is written by update.sh when a trxd.toml edited on
	# the USB drive passes --check.
	if [ -f /mnt/jffs2/trxd.toml ]; then
		echo /mnt/jffs2/trxd.toml
	else
		echo /etc/trxd.toml
	fi
}

# Transmitter off whatever trxd left behind (a crash, a kill -9): the TX LO
# powered down, the configured PTT line low. Before every (re)start and on stop.
rf_off() {
	for d in /sys/bus/iio/devices/iio:device*; do
		[ "$(cat "$d/name" 2>/dev/null)" = ad9361-phy ] && echo 1 > "$d/out_altvoltage1_TX_LO_powerdown" 2>/dev/null
	done
	G=$(sed -n 's/^[[:space:]]*ptt_gpio[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "${1:-$(pick_config)}" 2>/dev/null | head -n 1)
	[ -n "$G" ] && [ -w "$G" ] && echo 0 > "$G"
	return 0
}

start() {
	CONF=$(pick_config)
	printf 'Starting trxd (%s): ' "$CONF"
	if ! $DAEMON --config "$CONF" --check >/dev/null 2>"$LOG"; then
		echo "config error, see $LOG"
		return 1
	fi
	# Keep restarting on a crash, but not in a tight loop. trxd asks for
	# another FPGA bitstream by writing /run/fpga-mode.want and exiting:
	# load it (fpga-mode: the PL reloaded, the drivers bound again) and
	# start trxd again at once (docs/FPGA-MODES.md).
	start-stop-daemon -S -b -m -p "$PIDFILE" -x /bin/sh -- -c \
		"while :; do /etc/init.d/S80trxd rf-off '$CONF'; if [ -f /run/fpga-mode.want ]; then /usr/sbin/fpga-mode \$(cat /run/fpga-mode.want) >>$LOG 2>&1; rm -f /run/fpga-mode.want; fi; RUST_LOG=\${RUST_LOG:-info} $DAEMON --config '$CONF' >>$LOG 2>&1; [ -f /run/fpga-mode.want ] || sleep 5; done"
	echo "OK"
}

stop() {
	printf 'Stopping trxd: '
	start-stop-daemon -K -q -p "$PIDFILE"
	killall trxd 2>/dev/null
	sleep 1
	killall -9 trxd 2>/dev/null
	rf_off
	# No PL DMA left writing RAM into a reboot (rcK stops trxd this way).
	# Not on a restart: a trxd started on a bitstream just quiesced this
	# way hung the board (2026-10-02, cause not found yet).
	[ "$1" = restart ] || { [ -x /usr/sbin/fpga-mode ] && /usr/sbin/fpga-mode stop-dma >/dev/null 2>&1; }
	rm -f "$PIDFILE"
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop restart; sleep 1; start ;;
	rf-off) rf_off "$2" ;;
	*) echo "Usage: $0 {start|stop|restart|rf-off}"; exit 1 ;;
esac
