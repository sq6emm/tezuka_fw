config BR2_PACKAGE_BOARD_FPGA
	bool "board-fpga"
	help
	  Install pre-built FPGA bitstream for the target board.

config BR2_PACKAGE_BOARD_FPGA_BOARD
	string "Board name for bitstream path"
	depends on BR2_PACKAGE_BOARD_FPGA
	help
	  Name of the board directory under board/tezuka/ containing
	  the bitstream in bitstream/<project>.xsa (see
	  BR2_PACKAGE_BOARD_FPGA_PROJECT for <project>).
	  Examples: pluto, plutoplus, e200, fishball7010, fishball7020

config BR2_PACKAGE_BOARD_FPGA_PROJECT
	string "Bitstream project name"
	default "tezuka"
	depends on BR2_PACKAGE_BOARD_FPGA
	help
	  Name of the maia-hdl project that produced the bitstream, used as
	  the .xsa filename: board/tezuka/<board>/bitstream/<project>.xsa.
	  Most boards use the default "tezuka" project; boards built from a
	  different maia-hdl project (e.g. "ka9q") should set this to match.

config BR2_PACKAGE_BOARD_FPGA_MODES
	string "FPGA modes to install"
	default ""
	depends on BR2_PACKAGE_BOARD_FPGA
	help
	  Space-separated FPGA modes (docs/FPGA-MODES.md) the image carries:
	  "trx" for the BASIC flavour, empty for every <project>-<mode>.xsa
	  the board has (BASIC+). The boot mode is always included.

config BR2_PACKAGE_BOARD_FPGA_FLAVOUR
	string "Firmware flavour"
	default ""
	depends on BR2_PACKAGE_BOARD_FPGA
	help
	  basic or plus (docs/FLAVOURS.md); written to /etc/fw-flavour and
	  into the image's VERSION.
