#!/bin/sh
#
# fpga-mode NAME: load the FPGA bitstream for a trxd mode at runtime
# (/lib/firmware/fpga-NAME.bin, the byte-swapped .bin the zynq fpga
# manager takes). fpga-mode with no argument prints the loaded one;
# fpga-mode stop-dma only stops the PL's DMA (see quiesce below).
#
# The whole PL is reconfigured, so nothing may touch it meanwhile: trxd must
# not be running (its S80trxd loop calls this between runs), the drivers of
# the PL devices are unbound first and bound again after (the AD936x phy
# too: it tunes the digital interface into the new fabric), and on LibreSDR
# the GPSDO script is stopped and started again through S22gpsdo; the
# vctcxo_lock registers (control, set point / manual DAC code, reference
# source) are read before the reload and written back after it, so the
# VCTCXO keeps its setting: the reset values made the script's warm-start
# check (error 0: "already locked") adopt the reset DAC code, 12 ppm off.
#
# Before the reload every PL bus master is brought to rest (quiesce): a DMA
# cut off in the middle of a burst can wedge the HP port it writes through
# and hang the board. trxd does the same on its way out (fpgamode.rs); this
# covers a trxd that crashed.
#
# /run/fpga-mode holds the loaded mode ("boot": the one U-Boot loaded).

FW=/lib/firmware
STATE=/run/fpga-mode
MGR=/sys/class/fpga_manager/fpga0
LOG=/var/log/fpga-mode.log

cur=$(cat $STATE 2>/dev/null || cat /etc/fpga-boot-mode 2>/dev/null || echo trx)

hex() { printf '%d' "$1"; }

# devmem on a register that may be absent: only ids that read back are
# trusted (an absent slave answers DECERR: devmem dies, nothing else)
rd() { devmem "$1" 32 2>/dev/null || echo 0; }

quiesce() {
	# a PL that is not configured answers nothing: any access would hang
	[ "$(cat $MGR/state 2>/dev/null)" = operating ] || return 0
	# Maia ring recorder (DATV): stop, then wait for its last burst
	# (committed address still for three polls)
	if [ "$(rd 0x7C460000)" = 0x6169616D ]; then
		devmem 0x7C460010 32 2
		last=; n=0
		for i in $(seq 50); do
			c=$(rd 0x7C460018)
			if [ "$c" = "$last" ]; then n=$((n + 1)); [ $n -ge 3 ] && break; else n=0; fi
			last=$c; usleep 2000
		done
		# the spectrometer DMA writes a 32 KB buffer per integration:
		# right after one is done (its index moves) it is idle for tens
		# of ms; hold the core in sdr_reset from then on
		b0=$(( ($(hex $(rd 0x7C460020)) >> 12) & 7 ))
		for i in $(seq 100); do
			b=$(( ($(hex $(rd 0x7C460020)) >> 12) & 7 ))
			[ $b != $b0 ] && break
			usleep 2000
		done
		devmem 0x7C460008 32 1
	fi
	# DATV transmit back to IQ (encoder in reset): DAC GPIO bits 1-4
	g=$(hex $(rd 0x790240BC))
	devmem 0x790240BC 32 $((g & ~30))
	case "$cur" in
	datv|s2|t2)
		# LDPC decoder ("LDP*"): its DDR engine runs only while busy
		case "$(rd 0x43C4FF08)" in 0x3?50444C)
			for i in $(seq 100); do
				[ $(( $(hex $(rd 0x43C4FF04)) & 1 )) = 0 ] && break
				usleep 5000
			done;;
		esac
		# DVB-T2 cell router ("T2R1"): off, then a moment for its writes
		if [ "$(rd 0x43C6003C)" = 0x31523254 ]; then
			devmem 0x43C60000 32 0; usleep 5000
		fi;;
	esac
	case "$cur" in
	trx)
		# CW-RS network ("RSF*"): reads its weights only while busy
		case "$(rd 0x43C5FF08)" in 0x3?465352)
			for i in $(seq 100); do
				[ $(( $(hex $(rd 0x43C5FF04)) & 1 )) = 0 ] && break
				usleep 5000
			done;;
		esac;;
	esac
}

# fpga-mode stop-dma: only bring the PL's bus masters to rest (S80trxd stop:
# a reboot must not leave a DMA writing RAM under U-Boot). Idempotent; the
# Maia core stays in sdr_reset until trxd starts it again.
[ "$1" = stop-dma ] && { quiesce; exit 0; }
[ -z "$1" ] && { echo "$cur"; exit 0; }
want=$1
[ "$want" = "$cur" ] && exit 0

# The boot mode's bitstream is not in the rootfs (flash space): take it out
# of the running slot's FIT (U-Boot's fpga@1, gzip) the first time.
if [ ! -f "$FW/fpga-$want.bin" ] && [ "$want" = "$(cat /etc/fpga-boot-mode 2>/dev/null)" ]; then
	slot=$(sed -n 's/.*UBOOT_SLOT=\([ab]\).*/\1/p' /proc/cmdline)
	mtd=$(sed -n "s/^\(mtd[0-9]*\):.*\"linux-$slot\"/\1/p" /proc/mtd)
	if [ -n "$mtd" ]; then
		mkdir -p $FW
		/usr/bin/trxd --fit-data /dev/$mtd /images/fpga@1 | zcat | /usr/bin/trxd --bit2bin > $FW/fpga-$want.bin.tmp \
			&& mv $FW/fpga-$want.bin.tmp $FW/fpga-$want.bin || rm -f $FW/fpga-$want.bin.tmp
	fi
fi
[ -f "$FW/fpga-$want.bin" ] || { echo "fpga-mode: no $FW/fpga-$want.bin" >&2; exit 1; }
pidof trxd >/dev/null && { echo "fpga-mode: trxd is running" >&2; exit 1; }

log() { echo "$(date +%T) $*" >> $LOG; logger -t fpga-mode "$*" 2>/dev/null; }

# driver:device, in probe order (unbound in reverse)
DEVS="uio_pdrv_genirq:7c460000.maia-sdr
dma-axi-dmac:7c400000.dma
dma-axi-dmac:7c420000.dma
ad9361:spi0.0
cf_axi_dds:79024000.cf-ad9361-dds-core-lpc
cf_axi_adc:79020000.cf-ad9361-lpc"

bus_of() { case "$1" in ad9361) echo spi;; *) echo platform;; esac; }

unbind_all() {
	for d in $(echo "$DEVS" | sed -n '1!G;h;$p'); do
		drv=${d%%:*}; dev=${d#*:}; b=/sys/bus/$(bus_of $drv)/drivers/$drv
		[ -e "$b/$dev" ] && echo "$dev" > "$b/unbind"
	done
}

bind_all() {
	ok=0
	for d in $DEVS; do
		drv=${d%%:*}; dev=${d#*:}; b=/sys/bus/$(bus_of $drv)/drivers/$drv
		[ -e "$b/$dev" ] || echo "$dev" > "$b/bind" || ok=1
	done
	return $ok
}

gpsdo=
[ -x /etc/init.d/S22gpsdo ] && [ -f /var/run/gpsdo_boot.pid ] && gpsdo=1

log "$cur -> $want"
[ -n "$gpsdo" ] && { /etc/init.d/S22gpsdo stop >/dev/null 2>&1; sleep 1; }
if [ -n "$gpsdo" ]; then
	vc_ctrl=$(devmem 0x43C00000 32); vc_set=$(devmem 0x43C00004 32); vc_ref=$(devmem 0x43C0000C 32)
	log "vctcxo_lock ctrl $vc_ctrl set $vc_set ref $vc_ref"
fi
quiesce
unbind_all
echo 0 > $MGR/flags
if echo "fpga-$want.bin" > $MGR/firmware && [ "$(cat $MGR/state)" = operating ]; then
	echo "$want" > $STATE
	r=0
else
	log "load of fpga-$want.bin failed (state $(cat $MGR/state))"
	echo unknown > $STATE
	r=1
fi
if [ -n "$gpsdo" ] && [ -n "$vc_ctrl" ]; then
	devmem 0x43C00004 32 $vc_set; devmem 0x43C0000C 32 $vc_ref; devmem 0x43C00000 32 $vc_ctrl
fi
bind_all || { log "rebinding failed"; r=1; }
[ -n "$gpsdo" ] && /etc/init.d/S22gpsdo start >/dev/null 2>&1
log "now $(cat $STATE)"
exit $r
